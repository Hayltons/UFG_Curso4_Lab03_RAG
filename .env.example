# Caminho relativo à raiz do projeto, ou caminho absoluto.
PDF_PATH=data/guia-pratico-engenharia-software-com-ia-generativa.pdf

# Modelo de embeddings e LLM são independentes.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OLLAMA_MODEL=gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=120

# Parâmetros iniciais do RAG; reavaliar a qualidade no CAP05.
TOP_K=4
CHUNK_SIZE=350
CHUNK_OVERLAP=50
MAX_CONTEXT_CHARS=2500
